generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum PropertyType {
  HOUSE
  APARTMENT
  CONDO
  TOWNHOUSE
  LAND
  COMMERCIAL
}

enum ListingStatus {
  FOR_SALE
  FOR_RENT
  PENDING
  SOLD
}

enum InquiryStatus {
  NEW
  CONTACTED
  CLOSED
}

model User {
  id           String     @id @default(cuid())
  name         String?
  email        String     @unique
  passwordHash String
  role         Role       @default(USER)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  listings     Listing[]  @relation("ListingsCreatedBy")
  favorites    Favorite[]
}

model Listing {
  id            String         @id @default(cuid())
  title         String
  description   String
  address       String
  city          String
  state         String
  zipCode       String
  latitude      Float?
  longitude     Float?
  price         Int
  bedrooms      Int
  bathrooms     Float
  squareFeet    Int
  propertyType  PropertyType
  listingStatus ListingStatus  @default(FOR_SALE)
  yearBuilt     Int?
  lotSize       Int?
  createdById   String
  createdBy     User           @relation("ListingsCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  images        ListingImage[]
  favorites     Favorite[]
  inquiries     Inquiry[]

  @@index([city])
  @@index([zipCode])
  @@index([listingStatus])
  @@index([propertyType])
  @@index([price])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  imageUrl  String
  altText   String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}

model Inquiry {
  id        String        @id @default(cuid())
  listingId String
  listing   Listing       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  name      String
  email     String
  phone     String?
  message   String
  status    InquiryStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([listingId])
  @@index([status])
}